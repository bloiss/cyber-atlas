{
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.tabSize": 2,
  "files.encoding": "utf8",
  "files.eol": "\n",
  "liveServer.settings.port": 5500,
  "liveServer.settings.root": "/",
  "cSpell.language": "fr,en",
  "json.schemas": [
    { "fileMatch": ["data/toolbox.json"], "url": "./schemas/toolbox.schema.json" },
    { "fileMatch": ["data/lexique.json"], "url": "./schemas/lexique.schema.json" },
    { "fileMatch": ["data/plateformes.json"], "url": "./schemas/plateformes.schema.json" },
    { "fileMatch": ["data/projets.json"], "url": "./schemas/projets.schema.json" }
  ]
}
