{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Outils de la Toolbox",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["nom", "categorie", "niveau", "description", "lien"],
    "additionalProperties": false,
    "properties": {
      "nom": { "type": "string", "description": "Nom de l'outil" },
      "categorie": {
        "type": "string",
        "enum": ["Réseau", "Web", "OSINT", "Crypto", "Stéganographie", "Forensic", "Reverse", "Mots de passe", "Pentest", "Défense", "Lab"]
      },
      "niveau": { "type": "string", "enum": ["Essentiel", "Utile", "Avancé"] },
      "description": { "type": "string", "description": "Une phrase : à quoi ça sert" },
      "lien": { "type": "string", "format": "uri", "pattern": "^https://" }
    }
  }
}
