{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Plateformes d'entraînement",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["nom", "niveau", "domaines", "langue", "cout", "lien", "pourquoi"],
    "additionalProperties": false,
    "properties": {
      "nom": { "type": "string" },
      "niveau": { "type": "string", "enum": ["Débutant", "Intermédiaire", "Avancé", "Tous niveaux"] },
      "domaines": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
      "langue": { "type": "string", "enum": ["FR", "EN"] },
      "cout": { "type": "string", "enum": ["Gratuit", "Freemium", "Payant"] },
      "lien": { "type": "string", "format": "uri", "pattern": "^https://" },
      "pourquoi": { "type": "string" }
    }
  }
}
