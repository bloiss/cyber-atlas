{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Bibliothèque",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["titre", "format", "themes", "langue", "lien", "pourquoi"],
    "additionalProperties": false,
    "properties": {
      "titre": { "type": "string" },
      "format": { "type": "string", "enum": ["YouTube", "Cours", "Documentaire", "Série", "Podcast", "Livre"] },
      "themes": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
      "langue": { "type": "string", "enum": ["FR", "EN"] },
      "lien": { "type": "string", "format": "uri", "pattern": "^https://" },
      "pourquoi": { "type": "string" }
    }
  }
}
